{
  "name": "satono-long-tongue",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint site/assets/js --ext .ts",
    "format": "prettier --write \"site/**/*.{html,css,ts,md}\"",
    "format:check": "prettier --check \"site/**/*.{html,css,ts,md}\"",
    "build": "hugo -s site --minify",
    "dev": "hugo server -s site -D",
    "preview": "hugo server -s site --minify"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  }
}